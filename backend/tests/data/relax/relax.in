&CONTROL
  calculation   = 'relax'
  outdir        = './tmp/'
  pseudo_dir    = './pseudo/'
  prefix        = 'al'
  etot_conv_thr = 2e-05
  forc_conv_thr = 0.0005
  tstress       = .true.
  tprnfor       = .true.
/
&SYSTEM
  ibrav       = 0
  nat         = 2
  ntyp        = 1
  ecutwfc     = 20.0
  ecutrho     = 80.0
  occupations = 'smearing'
  degauss     = 0.01
  smearing    = 'cold'
/
&ELECTRONS
  conv_thr = 4e-10
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  Al  26.9815  Al.pbe-tm-test.UPF
ATOMIC_POSITIONS {crystal}
  Al     0.0000784573     0.015835395    -0.003570848
  Al     0.4877079001    0.0188030404     0.018802635
K_POINTS {automatic}
  3 6 6 0 0 0
CELL_PARAMETERS {angstrom}
  0.0  4.05  4.05
  2.025  0.0  2.025
  2.025  2.025  0.0
